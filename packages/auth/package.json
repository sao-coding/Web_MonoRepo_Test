{
  "name": "@msi/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "clean": "rm -rf .turbo dist",
    "dev": "tsup src/index.ts --watch --dts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@msi/eslint-config": "workspace:*",
    "@types/js-cookie": "^3.0.2",
    "@types/react": "^19.2.1",
    "eslint": "^9.23.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "license": "MIT"
}
