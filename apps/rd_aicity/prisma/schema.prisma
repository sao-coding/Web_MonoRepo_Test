generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AI_App_Action_Log {
  F_SeqNo      Int         @id(map: "PK__AI_App_A__B8E02AA7CB7764A1") @default(autoincrement())
  F_CreateTime DateTime    @default(now(), map: "DF__AI_App_Ac__F_Cre__571DF1D5") @db.DateTime
  F_UpdateTime DateTime    @default(now(), map: "DF__AI_App_Ac__F_Upd__5812160E") @db.DateTime
  F_Stat       String      @db.NChar(1)
  app_id       Int
  action       Int
  user_id      String?     @db.NVarChar(20)
  ip_address   String?     @db.NVarChar(15)
  AI_App_List  AI_App_List @relation(fields: [app_id], references: [F_SeqNo], onUpdate: NoAction, map: "FK__AI_App_Ac__app_i__59063A47")
}

model AI_App_List {
  F_SeqNo            Int                 @id(map: "PK__AI_App_L__B8E02AA78BE06FDB") @default(autoincrement())
  F_CreateTime       DateTime            @default(now(), map: "DF__AI_App_Li__F_Cre__2645B050") @db.DateTime
  F_UpdateTime       DateTime            @default(now(), map: "DF__AI_App_Li__F_Upd__2739D489") @db.DateTime
  F_Stat             String              @db.NChar(1)
  app_id             String?             @db.NVarChar(100)
  name               String              @db.NVarChar(30)
  app_folder         String              @db.NVarChar(30)
  description        String?             @db.NVarChar(Max)
  version            String              @db.NVarChar(10)
  logo               String?             @db.NVarChar(200)
  link               String?             @db.NVarChar(200)
  releases           Boolean
  update_required    Boolean
  update_description String?             @db.NVarChar(500)
  app_type           Int?
  F_IsPermissions    String?             @db.NChar(1)
  AI_App_Action_Log  AI_App_Action_Log[]
  AI_App_Login_Log   AI_App_Login_Log[]
}

model AI_App_Login_Log {
  F_SeqNo       Int          @id(map: "PK__AI_App_L__B8E02AA7FF28DE5B") @default(autoincrement())
  F_CreateTime  DateTime     @default(now(), map: "DF__AI_App_Lo__F_Cre__52593CB8") @db.DateTime
  F_UpdateTime  DateTime     @default(now(), map: "DF__AI_App_Lo__F_Upd__534D60F1") @db.DateTime
  F_Stat        String       @db.NChar(1)
  app_id        Int?
  username      String       @db.NVarChar(20)
  password      String       @db.NVarChar(20)
  login_time    DateTime     @db.DateTime
  ip_address    String?      @db.NVarChar(20)
  login_status  Int
  error_message String?      @db.NVarChar(Max)
  token         String?      @db.NVarChar(Max)
  token_type    String?      @db.NVarChar(10)
  expires_at    String?      @db.NVarChar(20)
  AI_App_List   AI_App_List? @relation(fields: [app_id], references: [F_SeqNo], onDelete: NoAction, onUpdate: NoAction, map: "FK__AI_App_Lo__app_i__5441852A")
}

