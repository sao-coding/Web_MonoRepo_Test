{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2017",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@msi/config": ["../../packages/config/src/index.ts"],
      "@msi/config/*": ["../../packages/config/src/*"],
      "@msi/auth": ["../../packages/auth/dist/index.d.ts"],
      "@msi/auth/*": ["../../packages/auth/*"],
      "@msi/ui": ["../../packages/ui/dist/index.d.ts"],
      "@msi/ui/*": ["../../packages/ui/*"],
      "@msi/eslint-config/*": ["../../packages/eslint-config/*"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
