{
  "name": "monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:apps": "turbo build --filter=./apps/*",
    "build:packages": "turbo build --filter=./packages/*",
    "check-types": "turbo run check-types",
    "check": "turbo lint && pnpm turbo run check-types && pnpm check:knip && pnpm check:spelling",
    "check:knip": "knip",
    "check:spelling": "cspell",
    "commit": "pnpm cz",
    "cz": "cross-env NODE_OPTIONS=\"--experimental-transform-types --disable-warning=ExperimentalWarning\" czg",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "prepare": "husky && pnpm build:packages",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@msi/eslint-config": "workspace:*",
    "@msi/prettier-config": "workspace:*",
    "@msi/tsconfig": "workspace:*",
    "@types/node": "^22.14.0",
    "cross-env": "^7.0.3",
    "cspell": "^8.19.3",
    "czg": "^1.11.1",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "knip": "^5.48.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "tsup": "8.4.0",
    "turbo": "^2.5.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "ttf2woff2",
      "unrs-resolver"
    ]
  }
}
