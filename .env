# =============================================================================
# Web_MonoRepo_Test - 公開環境變數
# =============================================================================
# 此檔案包含 URL、IP、公開設定等可上版控的參數
# 機密參數請參考 .config.example 並在 projects_variables_developer 設定
#
# 使用方式:
#   本地開發: 複製 .config.example 為 .config 並填入機密值
#   Docker:   docker compose --env-file .env -f docker-compose.dev.yml up -d

# =============================================================================
# 網站基礎設定
# =============================================================================
NEXT_PUBLIC_BASE_PATH_URL=/AI_City

# =============================================================================
# Development 環境 (10.16.20.11)
# =============================================================================

# 首頁網址
NEXT_PUBLIC_RD_SITE_URL=http://10.16.20.11:8012

# 登入服務 API URL
NEXT_PUBLIC_LOGIN_API_URL=http://10.16.20.11:8085

# 登入 cookie 網域設定
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# NIM 服務 API URL
NEXT_PUBLIC_NIM_SERVICE_API_URL=http://10.16.20.152:8090

# 系統 API
NEXT_PUBLIC_PATENT_SERVICE_API_URL=http://10.16.20.11:8081

# AI 端 API
NEXT_PUBLIC_AI_API_URL=http://10.16.20.152:8086

# VGA AI API
NEXT_PUBLIC_VGA_AI_API_URL=http://10.16.20.152:8102

# PostHog 分析 URL
NEXT_PUBLIC_POSTHOG_HOST=http://172.16.111.149
