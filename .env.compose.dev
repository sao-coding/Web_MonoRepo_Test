# ===== Traefik =====
TRAEFIK_IMAGE=traefik:v3.6.6
TRAEFIK_CONTAINER=traefik-dev
TRAEFIK_ENTRYPOINT_WEB_ADDR=:80
TRAEFIK_HOSTPORT_WEB=8080
TRAEFIK_HOSTPORT_DASHBOARD=8090

# ===== Shared =====
NETWORK_NAME=ai-city
APP_ENV=development
HOSTNAME=0.0.0.0
NODE_ENV=development

# ===== aicity =====
AICITY_CONTAINER=aicity-dev
AICITY_PORT=3001
AICITY_RULE=PathPrefix(`/AI_City`)
AICITY_PRIORITY=1
AICITY_ENTRYPOINT=web
AICITY_DOCKERFILE=apps/aicity/Dockerfile

# ===== product-spec =====
PRODUCTSPEC_CONTAINER=product-spec-dev
PRODUCTSPEC_PORT=3002
PRODUCTSPEC_RULE=PathPrefix(`/AI_City/ProductSpec`)
PRODUCTSPEC_PRIORITY=10
PRODUCTSPEC_ENTRYPOINT=web
PRODUCTSPEC_DOCKERFILE=apps/product-spec/Dockerfile

# ===== asr =====
ASR_CONTAINER=asr-dev
ASR_PORT=3003
ASR_RULE=PathPrefix(`/AI_City/asr`)
ASR_PRIORITY=10
ASR_ENTRYPOINT=web
ASR_DOCKERFILE=apps/asr/Dockerfile
